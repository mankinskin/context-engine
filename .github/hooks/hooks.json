{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "session-capture-hook --from-hook-stdin",
        "cwd": ".",
        "timeout": 300
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "session-capture-hook --from-hook-stdin",
        "cwd": ".",
        "timeout": 300
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "session-capture-hook --from-hook-stdin",
        "cwd": ".",
        "timeout": 120
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "session-capture-hook --from-hook-stdin",
        "cwd": ".",
        "timeout": 120
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "bash ../workflow-tools/tools/agent-hooks/run-configured-hook.sh wrapper \"bash ../workflow-tools/tools/agent-hooks/rtk-hook-copilot.sh\" -- bash ../workflow-tools/tools/agent-hooks/rtk-hook-copilot.sh",
        "cwd": ".",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "bash ../workflow-tools/tools/agent-hooks/run-configured-hook.sh \"another configured hook\" \"bash ../workflow-tools/tools/agent-hooks/preflight-write.sh\" -- bash ../workflow-tools/tools/agent-hooks/preflight-write.sh",
        "cwd": ".",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "bash ../workflow-tools/tools/agent-hooks/run-configured-hook.sh \"another configured hook\" \"session-capture-hook --from-hook-stdin\" -- session-capture-hook --from-hook-stdin",
        "cwd": ".",
        "timeout": 120
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "bash ../workflow-tools/tools/agent-hooks/validate-docs.sh",
        "cwd": ".",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "bash ../workflow-tools/tools/agent-hooks/terminal-pwd.sh",
        "cwd": ".",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "session-capture-hook --from-hook-stdin",
        "cwd": ".",
        "timeout": 120
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "session-capture-hook --from-hook-stdin",
        "cwd": ".",
        "timeout": 120
      }
    ]
  }
}