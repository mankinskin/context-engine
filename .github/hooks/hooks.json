{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash tools/agent-hooks/capture-hook-stdin.sh",
        "cwd": ".",
        "timeout": 300
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "bash tools/agent-hooks/capture-hook-stdin.sh",
        "cwd": ".",
        "timeout": 300
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "bash tools/agent-hooks/capture-hook-stdin.sh",
        "cwd": ".",
        "timeout": 120
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "bash tools/agent-hooks/capture-hook-stdin.sh",
        "cwd": ".",
        "timeout": 120
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "bash tools/agent-hooks/rtk-hook-copilot.sh",
        "cwd": ".",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "bash tools/agent-hooks/preflight-write.sh",
        "cwd": ".",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "bash tools/agent-hooks/capture-hook-stdin.sh",
        "cwd": ".",
        "timeout": 120
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "bash tools/agent-hooks/validate-docs.sh",
        "cwd": ".",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "bash tools/agent-hooks/terminal-pwd.sh",
        "cwd": ".",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "bash tools/agent-hooks/capture-hook-stdin.sh",
        "cwd": ".",
        "timeout": 120
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash tools/agent-hooks/capture-hook-stdin.sh",
        "cwd": ".",
        "timeout": 120
      }
    ]
  }
}