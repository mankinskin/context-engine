          kind: dir
          path: "agent-files/.agents/instructions"
          children[2]{name,kind,path}:
            INDEX.md,file,"agent-files/.agents/instructions/INDEX.md"
            README.md,file,"agent-files/.agents/instructions/README.md"
        - name: prompts
          kind: dir
          path: "agent-files/.agents/prompts"
          children[31]{name,kind,path}:
            audit.prompt.md,file,"agent-files/.agents/prompts/audit.prompt.md"
            "build-validate-tools.prompt.md",file,"agent-files/.agents/prompts/build-validate-tools.prompt.md"
            commit.prompt.md,file,"agent-files/.agents/prompts/commit.prompt.md"
            "debug-test.prompt.md",file,"agent-files/.agents/prompts/debug-test.prompt.md"
