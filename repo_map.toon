            "sync-model-prices.prompt.md",file,"agent-files/.agents/prompts/sync-model-prices.prompt.md"
            tdd.prompt.md,file,"agent-files/.agents/prompts/tdd.prompt.md"
            "ticket-next.prompt.md",file,"agent-files/.agents/prompts/ticket-next.prompt.md"
            ticket.prompt.md,file,"agent-files/.agents/prompts/ticket.prompt.md"
            tickets.prompt.md,file,"agent-files/.agents/prompts/tickets.prompt.md"
            "tool-grant-regression-probe.prompt.md",file,"agent-files/.agents/prompts/tool-grant-regression-probe.prompt.md"
            "transform-transcript.prompt.md",file,"agent-files/.agents/prompts/transform-transcript.prompt.md"
