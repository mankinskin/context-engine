format: repo_map_toon_v1
description: "Compact workspace structural map for low-token orientation"
usage: Read this before opening source files for structural orientation
refresh_command: "cargo run -p peek-cli -- . --repo-map --output repo_map.toon"
workspace:
  root: "//?/C:/Users/linus/git/3/meta-workspace/context-engine"
top_level_dirs[7]: config,"context-stack","duplication-reviews","memory-api","memory-viewers",tools,transcripts
crates:
  name: crates
  kind: dir
  path: crates
  children[3]:
    - name: "context-stack"
      kind: dir
      path: "crates/context-stack"
      children[8]:
        - name: "context-api"
          kind: dir
          path: "crates/context-stack/context-api"
          note: "crate=context-api"
        - name: "context-insert"
          kind: dir
          path: "crates/context-stack/context-insert"
          note: "crate=context-insert"
        - name: "context-read"
          kind: dir
          path: "crates/context-stack/context-read"
          note: "crate=context-read"
        - name: "context-search"
          kind: dir
          path: "crates/context-stack/context-search"
          note: "crate=context-search"
        - name: "context-trace"
          kind: dir
          path: "crates/context-stack/context-trace"
          note: "crate=context-trace"
        - name: "context-trace-macros"
          kind: dir
          path: "crates/context-stack/context-trace-macros"
          note: "crate=context-trace-macros"
        - name: ngrams
          kind: dir
          path: "crates/context-stack/ngrams"
          note: crate=ngrams
        - name: tools
          kind: dir
          path: "crates/context-stack/tools"
          children[4]:
            - name: cli
              kind: dir
              path: "crates/context-stack/tools/cli"
              children[1]{name,kind,path,note}:
                "context-cli",dir,"crates/context-stack/tools/cli/context-cli","crate=context-cli"
            - name: "context-editor"
              kind: dir
              path: "crates/context-stack/tools/context-editor"
              children[2]{name,kind,path,note}:
                kernel,dir,"crates/context-stack/tools/context-editor/kernel","crate=context-editor-kernel"
                "sandbox-app",dir,"crates/context-stack/tools/context-editor/sandbox-app","crate=sandbox-app"
            - name: http
              kind: dir
              path: "crates/context-stack/tools/http"
              children[1]{name,kind,path,note}:
                "context-http",dir,"crates/context-stack/tools/http/context-http","crate=context-http"
            - name: mcp
              kind: dir
              path: "crates/context-stack/tools/mcp"
              children[1]{name,kind,path,note}:
                "context-mcp",dir,"crates/context-stack/tools/mcp/context-mcp","crate=context-mcp"
    - name: "memory-api"
      kind: dir
      path: "crates/memory-api"
      children[2]:
        - name: crates
          kind: dir
          path: "crates/memory-api/crates"
          children[4]{name,kind,path,note}:
            "compact-terminal-api",dir,"crates/memory-api/crates/compact-terminal-api","crate=compact-terminal-api"
            "fs-api",dir,"crates/memory-api/crates/fs-api","crate=fs-api"
            "memory-fixtures",dir,"crates/memory-api/crates/memory-fixtures","crate=memory-fixtures"
            "memory-matrix",dir,"crates/memory-api/crates/memory-matrix","crate=memory-matrix"
        - name: tools
          kind: dir
          path: "crates/memory-api/tools"
          children[2]:
            - name: cli
              kind: dir
              path: "crates/memory-api/tools/cli"
              children[2]{name,kind,path,note}:
                "compact-terminal-cli",dir,"crates/memory-api/tools/cli/compact-terminal-cli","crate=compact-terminal-cli"
                "fs-cli",dir,"crates/memory-api/tools/cli/fs-cli","crate=fs-cli"
            - name: mcp
              kind: dir
              path: "crates/memory-api/tools/mcp"
              children[2]{name,kind,path,note}:
                "compact-terminal-mcp",dir,"crates/memory-api/tools/mcp/compact-terminal-mcp","crate=compact-terminal-mcp"
                "fs-mcp",dir,"crates/memory-api/tools/mcp/fs-mcp","crate=fs-mcp"
    - name: tools
      kind: dir
      path: crates/tools
      children[3]:
        - name: cli
          kind: dir
          path: crates/tools/cli
          children[1]{name,kind,path,note}:
            "crane-cli",dir,"crates/tools/cli/crane-cli","crate=crane-cli"
        - name: "dungeon-crawler"
          kind: dir
          path: "crates/tools/dungeon-crawler"
          note: "crate=dungeon-crawler"
        - name: "tracing-analyzer"
          kind: dir
          path: "crates/tools/tracing-analyzer"
          note: "crate=tracing-analyzer"
agent_guidance:
  name: "agent-guidance"
  kind: dir
  path: "agent-guidance"
  children[1]{name,kind,path}:
    AGENTS.md,file,"agent-guidance/AGENTS.md"
agent_files:
