            iteration.prompt.md,file,"agent-files/.agents/prompts/iteration.prompt.md"
            "memory-setup.prompt.md",file,"agent-files/.agents/prompts/memory-setup.prompt.md"
            "merge-dossiers.prompt.md",file,"agent-files/.agents/prompts/merge-dossiers.prompt.md"
            next.prompt.md,file,"agent-files/.agents/prompts/next.prompt.md"
            "refine-ingest.prompt.md",file,"agent-files/.agents/prompts/refine-ingest.prompt.md"
            research.prompt.md,file,"agent-files/.agents/prompts/research.prompt.md"
